{
  "name": "quorum",
  "version": "0.0.0",
  "license": "BUSL-1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:client": "tsc -p tsconfig.client.json && node scripts/copy-client-assets.mjs",
    "watch:client": "tsc -p tsconfig.client.json --watch",
    "client:dev": "npm run build:client && node scripts/serve-client.mjs",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "test:watch": "node --experimental-strip-types --test --watch 'src/**/*.test.ts'",
    "bots": "node --experimental-strip-types src/bots/simulate.ts",
    "dev": "QUORUM_ENV=local node --experimental-strip-types --watch src/server/main.ts",
    "dev:memory": "QUORUM_STORE=memory node --experimental-strip-types --watch src/server/main.ts",
    "start": "node --experimental-strip-types src/server/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1136.0",
    "@aws-sdk/lib-dynamodb": "^3.1136.0",
    "ws": "^8.21.3"
  }
}
