node_modules/
dist/
.env
.env.*
!.env.example

# The real question set is content about real people — Round S names a
# colleague's previous employer, their internal role and what they spent on a
# home lab — and this repo is public. Only the example is committed. The live
# file is a symlink to the private team-building repo, which is where the set
# is actually versioned; a copy here would be an unbacked-up second truth.
config/trivia-questions.json

# Event material: run of show, rosters, and the round about a named colleague.
# Same reason as the question file — this repository is public and these name
# real people. Kept here so the service and the session that runs on it live in
# one place; kept out of git so the people in them do not.
private/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# .terraform.lock.hcl is deliberately NOT ignored: it pins provider hashes so
# a run in HCP Terraform resolves what was tested here, not whatever is newest.

# macOS
.DS_Store
