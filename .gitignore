node_modules/
dist/
.env
.env.*
!.env.example

# One directory per event: its question set, its run of show, its roster. All
# of it is content about real people — the September 2026 huddle closes on five
# questions about a named colleague — and this repository is public. Only
# config/event.example/ is committed, as the format's worked example. The
# events themselves are unversioned and unbacked-up, which is the cost of that,
# and config/README.md says so rather than leaving it to be found.
config/events/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# .terraform.lock.hcl is deliberately NOT ignored: it pins provider hashes so
# a run in HCP Terraform resolves what was tested here, not whatever is newest.

# macOS
.DS_Store
