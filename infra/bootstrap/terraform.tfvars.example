# infra/bootstrap — copy to terraform.tfvars and fill in. Nothing here is a
# secret; it is all identifiers. terraform.tfvars is gitignored anyway, because
# the account id is not worth publishing for no reason.

# Twelve digits. Confirm with `aws sts get-caller-identity` using the same
# credentials you are about to apply with — applying bootstrap to the wrong
# account is the one mistake here that is annoying to undo.
aws_account_id = "000000000000"

# ARCHITECTURE.md picks Sydney. Only the ECR repository is regional; the roles
# and OIDC providers are global.
aws_region = "ap-southeast-2"

# HCP Terraform. The organization name as it appears in the URL, and the project
# the three quorum workspaces live in. Both are baked into the quorum-tfc-run
# trust policy verbatim.
tfc_organization = "your-org"
tfc_project      = "quorum"

# The GitHub repository whose main branch may push images. org/repo only.
github_repository = "phan-t/quorum"

# Optional. Whatever this account's tagging policy requires.
# additional_tags = {
#   CostCentre = "..."
#   Owner      = "..."
# }
